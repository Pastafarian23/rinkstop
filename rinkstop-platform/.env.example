# Supabase Project URL (from your Supabase dashboard)
NEXT_PUBLIC_SITE_URL=https://rinkstop.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key (anon key for client-side, service_role key for server-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Secret for blog publishing via approve-post.js
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generated:
API_SECRET=c8715ac4fa045dc58aa01ff7f1a679e53224454066e76beeb913b429dfa10336
# Change this to something unique for admin access:
ADMIN_SECRET=your-admin-secret-here

# Supabase URLs (update with your project)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-key
