# RinkStop Environment Variables Reference
#
# Copy this file to .env.local and fill in real values for local development.
# Production values are set via Vercel CLI (`vercel env add`).
#
# Required sections:
#   - Site
#   - Supabase
#   - Authentication (Clerk)
#   - Payments (Stripe)
#   - Email (Zoho)
#   - Identity Verification (Didit)
#   - Third-party APIs (Highlightly, Maton, Google Maps)
#   - Admin / API Secrets
#   - Passport Feature Flags (Workstream 1 — all default OFF)
#   - Cron / Webhook Secrets

# ============================================================================
# Site
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://rinkstop.com

# ============================================================================
# Supabase
# ============================================================================
# From your Supabase dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# Authentication (Clerk)
# ============================================================================
# From Clerk dashboard: API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Svix signing secret for /api/webhooks/clerk — Clerk dashboard → Webhooks → Endpoint
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================================================
# Payments (Stripe)
# ============================================================================
# Stripe API key (server-side)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret (different from price IDs!)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for the 2026-07-02 pricing redesign.
# Set these in Vercel production env using vercel-set-env.sh, and locally in .env.local.
# Federation tier is contact-sales only and has no Stripe product.
STRIPE_PRICE_VERIFIED_IDENTITY=price_...
STRIPE_PRICE_IDENTITY_PLUS=price_...
STRIPE_PRICE_CLUB_STARTER=price_...
STRIPE_PRICE_CLUB_PRO=price_...
STRIPE_PRICE_CLUB_ELITE=price_...
STRIPE_PRICE_LEAGUE=price_...
STRIPE_PRICE_BUSINESS_LISTING=price_...
STRIPE_PRICE_BUSINESS_PLUS=price_...

# ============================================================================
# Email (Zoho SMTP)
# ============================================================================
ZOHOMAIL_SMTP_HOST=smtp.zoho.com
ZOHOMAIL_SMTP_PORT=465
ZOHOMAIL_SMTP_SECURE=true
ZOHOMAIL_USER=support@rinkstop.com
ZOHOMAIL_APP_PASSWORD=your-zoho-app-password
ZOHOMAIL_FROM_ADDRESS=support@rinkstop.com
ZOHOMAIL_FROM_NAME=RinkStop

# ============================================================================
# Identity Verification (Didit.me)
# ============================================================================
# Vercel-only in production; for local dev set these too.
# https://docs.didit.me
DIDIT_API_KEY=your-didit-api-key
DIDIT_WORKFLOW_ID=your-free-kyc-workflow-uuid
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret

# ============================================================================
# Third-party APIs
# ============================================================================
# Highlightly — NHL/NCAAH and Hockey stats
HIGHLIGHTLY_API_KEY=your-highlightly-key

# Maton.ai — unified gateway for Telegram bot, GitHub, Zoho Mail
MATON_API_KEY=your-maton-api-key

# Google Maps — Maps JavaScript API + Static Maps API for /directory/map
# Canonical env var name is NEXT_PUBLIC_GOOGLE_MAPS_KEY (NOT ..._API_KEY).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ============================================================================
# Admin / API Secrets
# ============================================================================
# Admin bearer token for /api/admin/* routes (also checked by admin-auth.ts).
ADMIN_SECRET=your-admin-secret-here
# Optional admin API key (alternate)
ADMIN_API_KEY=your-admin-api-key
# Shared secret for blog publishing via approve-post.js
API_SECRET=generate-with-crypto-randomBytes-32

# ============================================================================
# Passport Feature Flags (Workstream 1)
# ============================================================================
# ALL flags default to false. Production stays unchanged until you flip them.
# See workstreams/workstream-1-foundation.md for the rollout sequence.
PASSPORT_ENABLED=false
PASSPORT_INTERNAL_API=false
PASSPORT_PUBLIC_LOOKUP=false
PASSPORT_MIGRATION=false
PASSPORT_EVENT_LOGGING=false
PASSPORT_DASHBOARD=false

# ============================================================================
# Cron / Webhook Secrets
# ============================================================================
# Vercel sets this automatically for cron jobs (Authorization: Bearer CRON_SECRET).
# For local dev, any non-empty value works.
CRON_SECRET=local-dev-cron-secret